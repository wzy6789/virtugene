{
  "name": "virtugene",
  "version": "2.0.2",
  "type": "module",
  "description": "Unlock Your Digital Soul",
  "author": "VirtuGene",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev:electron": "node scripts/build-electron.mjs && electron .",
    "dev:renderer": "vite",
    "dev": "concurrently -n electron,vite \"npm run dev:electron\" \"npm run dev:renderer\"",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build:parser": "node scripts/build-parser.mjs",
    "build": "npm run build:electron && npm run build:renderer",
    "package": "npm run build && electron-builder",
    "mobile:init": "node scripts/mobile-init.mjs",
    "mobile:sync": "npm run build:renderer && npx cap sync android",
    "mobile:build": "npm run mobile:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@tanstack/react-virtual": "^3.14.9",
    "dexie": "^4.0.11",
    "electron-updater": "^6.8.9",
    "pinyin-pro": "^3.29.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.3",
    "mammoth": "^1.12.1",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  }
}
